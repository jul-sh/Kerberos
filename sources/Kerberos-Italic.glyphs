},
{
code = "sub [one one.lf] by upArrow;\012sub [two two.lf] by northEastArrow;\012sub [three three.lf] by rightArrow;\012sub [four four.lf] by southEastArrow;\012sub [five five.lf] by downArrow;\012sub [six six.lf] by southWestArrow;\012sub [seven seven.lf] by leftArrow;\012sub [eight eight.lf] by northWestArrow;\012sub [nine nine.lf] by leftRightArrow;\012\012# Geometric shapes\012sub a by upDownArrow;\012sub b by blackDiamond;\012sub c by whiteDiamond;\012sub d by blackSquare;\012sub e by whiteSquare;\012sub f by mediumBlackSquare;\012sub g by upBlackTriangle;\012sub h by rightBlackTriangle;\012sub i by downBlackTriangle;\012sub j by leftBlackTriangle;\012sub k by upWhiteTriangle;\012sub l by rightWhiteTriangle;\012sub m by downWhiteTriangle;\012sub n by leftWhiteTriangle;";
name = ss02;
notes = "Name: Arrows, triangles and circles\012Arrows\012";
},
{
code = "sub h t by foundryicon;\012";
disabled = 1;
name = ss03;
notes = "Name: Foundry icon\012";
},
{
code = "sub less hyphen by leftArrow;\012sub hyphen asciicircum by upArrow;\012sub hyphen greater by rightArrow;\012sub asciicircum hyphen by downArrow;\012sub hyphen asciicircum less by northWestArrow;\012sub hyphen asciicircum greater by northEastArrow;\012sub greater asciicircum hyphen by southEastArrow;\012sub less asciicircum hyphen by southWestArrow;\012\012# Triangles\012sub less equal by leftBlackTriangle;\012sub equal asciicircum by upBlackTriangle;\012sub equal greater by rightBlackTriangle;\012sub asciicircum equal by downBlackTriangle;";
name = ss04;
notes = "Name: Dynamic arrows and triangles\012Second approximation\012Arrows 2\012";
},
