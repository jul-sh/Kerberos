{
automatic = 1;
code = "script latn;\012language NLD;\012sub iacute j by iacute_j.loclNLD;\012sub Iacute J by Iacute_J.loclNLD;\012language CAT;\012sub  l' periodcentered' l by ldot;\012sub  L' periodcentered' L by Ldot;\012language ROM;\012sub Scedilla by Scommaaccent;\012sub scedilla by scommaaccent;\012sub Tcedilla by Tcommaaccent;\012sub tcedilla by tcommaaccent;\012language MOL;\012sub Scedilla by Scommaaccent;\012sub scedilla by scommaaccent;\012sub Tcedilla by Tcommaaccent;\012sub tcedilla by tcommaaccent;\012language KAZ;\012sub i by idotaccent;\012language TAT;\012sub i by idotaccent;\012language TRK;\012sub i by idotaccent;\012language CRT;\012sub i by idotaccent;\012language AZE;\012sub i by idotaccent;\012\012script cyrl;\012language MKD;\012sub gje-cy by gje-cy.loclMKD;\012language BSH;\012sub Ghestroke-cy by Ghestroke-cy.loclBSH;\012sub Zedescender-cy by Zedescender-cy.loclBSH;\012sub ghestroke-cy by ghestroke-cy.loclBSH;\012sub zedescender-cy by zedescender-cy.loclBSH;\012language CHU;\012sub Esdescender-cy by Esdescender-cy.loclCHU;\012sub esdescender-cy by esdescender-cy.loclCHU;\012language SRB;\012sub be-cy by be-cy.loclSRB;\012sub ge-cy by ge-cy.loclSRB;\012sub de-cy by de-cy.loclSRB;\012sub pe-cy by pe-cy.loclSRB;\012sub te-cy by te-cy.loclSRB;\012";
name = locl;
notes = "-language GUA;\012-sub [quotesingle quoteright]' [A E I O U Atilde Etilde Itilde Otilde Utilde Y Ytilde] by Saltillo;\012-sub [quotesingle quoteright]' [a e i o u atilde etilde itilde otilde utilde y ytilde a.sc e.sc i.sc o.sc u.sc atilde.sc etilde.sc itilde.sc otilde.sc utilde.sc y.sc ytilde.sc] by saltillo;\012-language ESP;\012-sub [quotesingle quoteright]' [A E I O U Atilde Etilde Itilde Otilde Utilde Y Ytilde] by Saltillo;\012-sub [quotesingle quoteright]' [a e i o u atilde etilde itilde otilde utilde y ytilde a.sc e.sc i.sc o.sc u.sc atilde.sc etilde.sc itilde.sc otilde.sc utilde.sc y.sc ytilde.sc] by saltillo;\012";
},
{
code = "sub [zero zero.lf] by zeroinferior;\012sub [one one.lf] by oneinferior;\012sub [two two.lf] by twoinferior;\012sub [three three.lf] by threeinferior;\012sub [four four.lf] by fourinferior;\012sub [five five.lf] by fiveinferior;\012sub [six six.lf] by sixinferior;\012sub [seven seven.lf] by seveninferior;\012sub [eight eight.lf] by eightinferior;\012sub [nine nine.lf] by nineinferior;\012";
